#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: MIT

USE_PROCD=1

# rc.common normally calls procd_kill on every stop, even after the service
# has been unregistered. The default package prerm and explicit purge can
# both encounter this state. Skip ONLY the redundant delete when the ubus
# registry query succeeds and confirms that Parallax is absent.
# Keep normal procd error handling when the registry query itself fails.
# Return 0 only when procd lists this service, 1 when genuinely absent,
# and 2 if the query failed. Query errors must never masquerade as absence.
parallax_service_registered() {
    local entry
    if entry="$(ubus call service list '{"name":"parallax"}' 2>&1)"; then
        case "$entry" in
            *'"parallax"'*) return 0 ;;
            *) return 1 ;;
        esac
    fi
    printf 'Parallax: procd service lookup failed: %s\n' "$entry" >&2
    return 2
}

case "${action:-}" in
    stop|shutdown)
        if parallax_service_registered; then
            :
        else
            rc=$?
            [ "$rc" -eq 1 ] && unset USE_PROCD
        fi
        ;;
esac

# rc.common implements restart as an unconditional stop+start; when procd
# has no Parallax registration, suppress only the redundant stop. If the
# registry is unavailable, keep the real stop error visible.
parallax_stop_if_registered() {
    if parallax_service_registered; then
        stop "$@"
    else
        rc=$?
        [ "$rc" -eq 1 ] && return 0
        stop "$@"
    fi
}

restart() {
    trap '' TERM
    parallax_stop_if_registered "$@" || { trap - TERM; return 1; }
    trap - TERM
    start "$@"
}

START=95
STOP=10

. /lib/functions.sh
. /usr/share/parallax/platform.sh

start_service() {
    parallax_check_platform || return 1
    parallax_check_config || return 1

    local enabled
    config_load parallax
    config_get enabled main enabled 0

    # apk del preserves a customized enabled=1 UCI conffile. The protected
    # marker is created by the package's prerm and prevents default_postinst
    # from starting this status daemon during reinstall. postinst then clears
    # it after disabling package-created rc.d links.
    [ ! -f /etc/parallax/.reinstall-stopped ] || return 0

    # Even after the service is enabled, MVP-b never modifies nftables,
    # ip rule, DNS, routing tables, or the running proxy engine.
    [ "$enabled" = '1' ] || return 0

    procd_open_instance
    procd_set_param command /usr/bin/ucode /usr/share/parallax/daemon.uc
    procd_set_param file /etc/config/parallax
    procd_set_param respawn 3600 5 3
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

reload_service() {
    # Re-evaluate toggle; skip delete if procd never registered Parallax.
    parallax_stop_if_registered || return 1
    start
}

service_triggers() {
    procd_add_reload_trigger 'parallax'
}
